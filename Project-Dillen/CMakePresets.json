{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build-win",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
