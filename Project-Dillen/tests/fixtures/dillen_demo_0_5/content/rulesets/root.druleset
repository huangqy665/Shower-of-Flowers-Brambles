root_ruleset = {
    name = dillen.g.root
    version = 1

    required_packages = {
        requirement = { name = dillen.g.contracts   minimum_major = 1 minimum_minor = 0 minimum_patch = 0
                        maximum_major = 2 maximum_minor = 0 maximum_patch = 0 }
        requirement = { name = dillen.g.production  minimum_major = 1 minimum_minor = 0 minimum_patch = 0
                        maximum_major = 2 maximum_minor = 0 maximum_patch = 0 }
        requirement = { name = dillen.g.economy     minimum_major = 1 minimum_minor = 0 minimum_patch = 0
                        maximum_major = 2 maximum_minor = 0 maximum_patch = 0 }
        requirement = { name = dillen.g.research    minimum_major = 1 minimum_minor = 0 minimum_patch = 0
                        maximum_major = 2 maximum_minor = 0 maximum_patch = 0 }
        requirement = { name = dillen.g.content     minimum_major = 1 minimum_minor = 0 minimum_patch = 0
                        maximum_major = 2 maximum_minor = 0 maximum_patch = 0 }
    }

    required_schemas = {
        dillen.g.production_site = 1
        dillen.g.national_budget = 1
        dillen.g.research_project = 1
    }
    required_components = {
        dillen.g.treasury = 1
        dillen.g.resources = 1
    }
    required_relations = { dillen.g.owns = 1 }
    required_algorithms = {
        dillen.g.production_algorithm = 1
        dillen.g.budget_algorithm = 1
        dillen.g.research_algorithm = 1
    }
    required_definitions = {
        requirement = { mechanism = dillen.g.production_site   name = dillen.g.site_north }
        requirement = { mechanism = dillen.g.national_budget   name = dillen.g.alvara_budget }
        requirement = { mechanism = dillen.g.research_project  name = dillen.g.metallurgy }
    }
    required_entity_definitions = {
        requirement = { entity_type = dillen.g.country   name = dillen.g.alvara }
        requirement = { entity_type = dillen.g.province  name = dillen.g.north_reach }
        requirement = { entity_type = dillen.g.province  name = dillen.g.south_vale }
    }
    required_relation_definitions = {
        requirement = { relation = dillen.g.owns  name = dillen.g.alvara_north_reach }
        requirement = { relation = dillen.g.owns  name = dillen.g.alvara_south_vale }
    }
    required_spawns = {
        requirement = { mechanism = dillen.g.production_site   definition = dillen.g.site_north      name = dillen.g.site_north_spawn }
        requirement = { mechanism = dillen.g.national_budget   definition = dillen.g.alvara_budget   name = dillen.g.budget_spawn }
        requirement = { mechanism = dillen.g.research_project  definition = dillen.g.metallurgy      name = dillen.g.metallurgy_spawn }
    }
}
