# 经济:income = Σ 所辖各省的 ore,balance += income - upkeep
# 聚合(sum)与计数(count)都跨 owns 关系;减法与有序比较此前均不可表达。
algorithm_descriptor = {
    name = dillen.g.budget_algorithm
    version = 1
    backend = declarative
    entry_points = { create tick }
    deterministic = yes
    execution_policy = { instruction_budget = 48  failure_policy = fail_instance }

    program = {
        create = { transition_lifecycle = active }

        tick = {
            # 聚合:一条指令跨关系求和,按 N 计费
            set_field = {
                field = income
                left  = { role = capital
                          relation = { type = dillen.g.owns  direction = outgoing }
                          component = dillen.g.resources
                          field = ore
                          reduce = sum }
            }

            # 计数归约:同一条路径,换一个 reduce
            set_field = {
                field = provinces
                left  = { role = capital
                          relation = { type = dillen.g.owns  direction = outgoing }
                          component = dillen.g.resources
                          field = ore
                          reduce = count }
            }

            # 积分:balance += income - upkeep(两项都是字段)
            add_field = {
                field = balance
                op    = sub
                left  = { self_field = income }
                right = { self_field = upkeep }
            }

            # 破产判定:有序比较,右侧是常量
            set_field = {
                field = solvent
                value = no
                when = {
                    compare = {
                        left  = { self_field = balance }
                        op    = lt
                        right = { constant = 0 }
                    }
                }
            }
        }
    }
}
