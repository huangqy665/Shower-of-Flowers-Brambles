# 科研:progress += sponsor.science,progress >= cost 时完成
# `cost` 是字段而非字面量 —— 这正是旧 DSL 做不到的:条件只有 == 且右侧必须是字面量。
algorithm_descriptor = {
    name = dillen.g.research_algorithm
    version = 1
    backend = declarative
    entry_points = { create tick }
    deterministic = yes
    execution_policy = { instruction_budget = 32  failure_policy = fail_instance }

    program = {
        create = { transition_lifecycle = active }

        tick = {
            # 跨对象读:进度按赞助国的 science 速率累积
            add_field = {
                field = progress
                left  = { role = sponsor  component = dillen.g.treasury  field = science }
            }

            # 完成判定:两侧都是字段的有序比较
            set_field = {
                field = completed
                value = yes
                when = {
                    compare = {
                        left  = { self_field = progress }
                        op    = gte
                        right = { self_field = cost }
                    }
                }
            }
        }
    }
}
