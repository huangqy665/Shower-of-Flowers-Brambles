# 生产:output = min(capacity, ore x infra_level)
# 三条表达式在 DSL v1 之前一条都写不出来 —— 无字段操作数、无算术、无跨对象读。
algorithm_descriptor = {
    name = dillen.g.production_algorithm
    version = 1
    backend = declarative
    entry_points = { create tick }
    deterministic = yes
    execution_policy = { instruction_budget = 32  failure_policy = fail_instance }

    program = {
        create = { transition_lifecycle = active }

        tick = {
            # 潜在产量 = 所辖省份的 ore x infra_level
            set_field = {
                field = goods_output
                op    = mul
                left  = { role = province  component = dillen.g.resources  field = ore }
                right = { role = province  component = dillen.g.resources  field = infra_level }
            }
            # 受产能上限截断
            set_field = {
                field = goods_output
                op    = min
                left  = { self_field = goods_output }
                right = { role = province  component = dillen.g.resources  field = capacity }
            }
            # 记账:本次实际抽取的矿石量(整数字段,小数入整)
            set_field = {
                field = ore_drawn
                left  = { self_field = goods_output }
            }
        }
    }
}
