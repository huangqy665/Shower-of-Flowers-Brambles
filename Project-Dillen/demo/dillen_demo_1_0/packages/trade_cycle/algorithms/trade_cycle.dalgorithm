algorithm_descriptor = {
    name = dillen.demo1.trade_cycle_algorithm
    version = 1
    backend = declarative
    entry_points = { create tick }
    deterministic = yes
    execution_policy = {
        instruction_budget = 32
        wall_clock_warning_microseconds = 50000
        failure_policy = fail_instance
    }
    program = {
        create = {
            transition_lifecycle = active
            create_rng = {
                stream = dillen.demo1.trade_rng
                seed = 20260829
            }
        }
        tick = {
            add_field = {
                field = completed_cycles
                value = 1
            }
            add_field = {
                field = market_index
                value = 4
            }
            invoke_capability = {
                capability = dillen.demo1.market_pressure
                payload = 3
                delay = 1
                priority = 0
            }
            advance_rng = {
                stream = dillen.demo1.trade_rng
                count = 1
            }
        }
    }
}
