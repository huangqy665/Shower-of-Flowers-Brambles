algorithm_descriptor = {
    name = dillen.demo1.settlement_growth_algorithm
    version = 1
    backend = declarative
    entry_points = { create tick event }
    deterministic = yes
    execution_policy = {
        instruction_budget = 16
        wall_clock_warning_microseconds = 50000
        failure_policy = fail_instance
    }
    program = {
        create = {
            transition_lifecycle = active
        }
        tick = {
            add_field = {
                field = food_stock
                value = 2
            }
        }
        event = {
            add_field = {
                field = population
                from_payload = yes
                when = {
                    capability_invoked = dillen.demo1.market_pressure
                }
            }
        }
    }
}
