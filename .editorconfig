# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ipp}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Dillen authoring DSL
[*.{dpackage,dcapability,dcomponent,dentity,drelation,drelationdef,dmechanism,dalgorithm,ddefinition,dspawn,druleset}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
